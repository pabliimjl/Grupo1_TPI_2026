<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Producto</title>

    <link rel="stylesheet" href="/css/editar-producto.css">
</head>

<body>

<header>
    <h1>Editar Producto</h1>
    <a href="/admin/productos">← Volver</a>
</header>

<main>

    <form action="/admin/productos/<%= producto.id %>/editar" method="POST" enctype="multipart/form-data">

        <input type="hidden" name="id" value="<%= producto.id %>">

        <label>Marca</label>
        <input type="text" name="marca" value="<%= producto.marca %>" required>

        <label>Nombre producto</label>
        <input type="text" name="nombre_producto" value="<%= producto.nombre_producto %>" required>

        <label>Formato</label>
        <input type="text" name="formato" value="<%= producto.formato %>" required>

        <label>Precio</label>
        <input type="number" step="0.01" name="precio" value="<%= producto.precio %>" required>

        <label>Imagen</label>

        <input type="file" id="inputImagen" name="imagen">

        <input type="hidden" name="url_imagen" id="url_imagen" value="<%= producto.url_imagen %>">
        <input type="hidden" name="tipo_producto" id="tipo_producto" value="<%= producto.tipo_producto %>">

        <img src="<%= producto.url_imagen %>" style="max-width:120px;">

        <% if (producto.tipo_producto === "lubricante") { %>

            <hr>

            <h3>Datos de Lubricante</h3>

            <label>Densidad</label>
            <input type="text" name="densidad" value="<%= producto.lubricante?.densidad || '' %>">

            <label>Tipo (ej: sintético, mineral)</label>
            <input type="text" name="tipo" value="<%= producto.lubricante?.tipo || '' %>">

        <% } %>

        <% if (producto.tipo_producto === "estetica_vehicular") { %>

            <hr>

            <h3>Datos de Estética Vehicular</h3>

            <label>Categoría</label>
            <input type="text" name="categoria" value="<%= producto.esteticaVehicular?.categoria || '' %>">

        <% } %>

        <label>Activo</label>
        <select name="activo">
            <option value="true" <%= producto.activo ? "selected" : "" %>>Activo</option>
            <option value="false" <%= !producto.activo ? "selected" : "" %>>Inactivo</option>
        </select>

        <br><br>

        <button type="submit">Guardar cambios</button>

    </form>

</main>

</body>
</html>