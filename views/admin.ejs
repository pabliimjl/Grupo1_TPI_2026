<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración</title>

    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <header>

        <h1>Panel de Administración</h1>

        <button id="btnLogout">
            Cerrar sesión
        </button>

    </header>

    <main>

        <section class="bienvenida">

            <h2>Bienvenido</h2>

            <p>Seleccione una opción para administrar el sistema.</p>

        </section>

        <section class="opciones">

            <div class="card" id="productos">

                <h3>Productos</h3>

                <p>
                    Alta, modificación, activación y desactivación de productos.
                </p>

                <button>
                    Administrar
                </button>

            </div>

            <div class="card" id="ventas">

                <h3>Ventas</h3>

                <p>
                    Consultar todas las ventas realizadas.
                </p>

                <button>
                    Ver ventas
                </button>

            </div>

        </section>

    </main>

    <script src="/js/admin.js"></script>

</body>

</html>