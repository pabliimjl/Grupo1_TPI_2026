<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Panel de Administración</title>

    <link rel="stylesheet" href="/css/admin.css">

</head>

<body>

<header>

    <h1>Panel de Administración</h1>

    <button id="btnLogout">
        Cerrar sesión
    </button>

</header>

<main>

    <section class="categoria">

        <div class="titulo">

            <h2>Lubricantes</h2>

            <button onclick="window.location.href='/admin/productos/nuevo'">
                + Nuevo producto
            </button>

        </div>

        <table>

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Marca</th>
                    <th>Producto</th>
                    <th>Formato</th>
                    <th>Densidad</th>
                    <th>Tipo</th>
                    <th>Precio</th>
                    <th>Activo</th>
                    <th>Acciones</th>

                </tr>

            </thead>

            <tbody>

                <% lubricantes.forEach(producto => { %>

                    <tr>

                        <td><%= producto.id %></td>

                        <td>

                            <img
                                src="<%= producto.url_imagen %>"
                                class="imagenProducto">

                        </td>

                        <td><%= producto.marca %></td>

                        <td><%= producto.nombre_producto %></td>

                        <td><%= producto.formato %></td>

                        <td><%= producto.lubricante?.densidad %></td>

                        <td><%= producto.lubricante?.tipo %></td>

                        <td>$ <%= producto.precio %></td>

                        <td>
                        <% if (producto.activo) { %>
                            <span>Activo</span>
                        <% } else { %>
                            <span>Inactivo</span>
                        <% } %>
                        </td>

                        <td>
                        <a href="/admin/productos/<%= producto.id %>/editar">
                            Editar
                        </a>
                        |

                        <% if (producto.activo) { %>
                            <a href="/admin/productos/<%= producto.id %>/desactivar">
                            Desactivar
                            </a>
                        <% } else { %>
                            <a href="/admin/productos/<%= producto.id %>/activar">
                            Activar
                            </a>
                        <% } %>
                        </td>


                    </tr>

                <% }) %>

            </tbody>

        </table>

    </section>

    <section class="categoria">

        <h2>Estética Vehicular</h2>

        <table>

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Marca</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Formato</th>
                    <th>Precio</th>
                    <th>Activo</th>
                    <th>Acciones</th>

                </tr>

            </thead>

            <tbody>

                <% esteticas.forEach(producto => { %>

                    <tr>

                        <td><%= producto.id %></td>

                        <td>

                            <img
                                src="<%= producto.url_imagen %>"
                                class="imagenProducto">

                        </td>

                        <td><%= producto.marca %></td>

                        <td><%= producto.nombre_producto %></td>

                        <td><%= producto.esteticaVehicular?.categoria %></td>

                        <td><%= producto.formato %></td>

                        <td>$ <%= producto.precio %></td>

                        <td>
                        <% if (producto.activo) { %>
                            <span>Activo</span>
                        <% } else { %>
                            <span>Inactivo</span>
                        <% } %>
                        </td>

                        <td>
                        <a href="/admin/productos/<%= producto.id %>/editar">
                            Editar
                        </a>
                        |

                        <% if (producto.activo) { %>
                            <a href="/admin/productos/<%= producto.id %>/desactivar">
                            Desactivar
                            </a>
                        <% } else { %>
                            <a href="/admin/productos/<%= producto.id %>/activar">
                            Activar
                            </a>
                        <% } %>
                        </td>


                    </tr>

                <% }) %>

            </tbody>

        </table>

    </section>

</main>

<script src="/js/admin.js"></script>

</body>

</html>